{
  "name": "smaug-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Smaug's Hoard — front-end for the project-smaug analysis API",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:local": "SMAUG_FRONTEND_MODE=local next build",
    "start:local": "SMAUG_FRONTEND_MODE=local next start --hostname 0.0.0.0",
    "local": "npm run build:local && npm run start:local",
    "lint": "next lint",
    "typecheck": "npm run check:client-data-boundary && tsc --noEmit",
    "check:client-data-boundary": "node scripts/check-client-data-boundary.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
