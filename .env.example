# ==== Fonte de dados ====
# Fonte ativa da ingestão: "cvm" (padrão) ou "brapi". Só UMA por vez.
# Trocar aqui basta — as duas usam a mesma porta, sem reescrever código.
INGESTION_SOURCE=cvm

# ==== CVM ====
# Ano do arquivo ITR a espelhar (baixado de dados.cvm.gov.br). 2024 é o padrão.
CVM_YEAR=2024

# ==== Preço (B3) ====
# De onde vêm os preços: "b3" lê a série histórica que a própria B3 publica
# (sem token, sem plano); "vendors" é o arranjo Yahoo+brapi (padrão por ora).
# A B3 publica o preço COMO NEGOCIADO, e as contagens de ações são restatadas
# para a base atual (ADR 0027) — as duas pontas têm de ficar na mesma base, ou
# toda empresa que já desdobrou sai com capitalização errada. O padrão vira "b3"
# quando os fatores de evento societário entrarem (ADR 0032).
PRICE_SOURCE=vendors

# ==== brapi ====
# Token de autenticação (só necessário quando INGESTION_SOURCE=brapi).
# Gere em https://brapi.dev/dashboard. NUNCA commite o .env real.
BRAPI_TOKEN=
BRAPI_BASE_URL=https://brapi.dev/api

# ==== MongoDB (espelho cru da Fase 1) ====
MONGO_URI=mongodb://localhost:27017
MONGO_DB=smaug

# ==== PostgreSQL (indicadores derivados da Fase 2) ====
POSTGRES_URI=postgresql+asyncpg://smaug:smaug@localhost:5432/smaug

# ==== Coleta ====
# Pausa entre requisições (segundos) para respeitar o rate limit da brapi
REQUEST_DELAY_SECONDS=2
