# Nenhuma variável aqui é segredo: todas as fontes são públicas e sem
# autenticação — os arquivos da CVM e os da própria B3 (ADR 0041).

# ==== CVM ====
# Ano do arquivo a espelhar (baixado de dados.cvm.gov.br). 2024 é o padrão.
CVM_YEAR=2024
# Quais módulos coletar (JSON). Omitido = todos os do padrão, incluindo os dois
# que vêm da B3 (CAPITAL_EVENT_B3, CASH_DIVIDEND_B3).
# CVM_MODULES=["DRE","CAPITAL"]
# Camada Bronze imutável; não é cache e não sofre expiração automática.
# SOURCE_ARTIFACT_DIR=.artifacts/sources

# ==== MongoDB (espelho cru da Fase 1) ====
MONGO_URI=mongodb://localhost:27017
MONGO_DB=smaug

# ==== PostgreSQL (indicadores derivados da Fase 2) ====
POSTGRES_URI=postgresql+asyncpg://smaug:smaug@localhost:5432/smaug

# ==== API (leitura + favoritar/desfavoritar ticker, #151) ====
# Única origem liberada por CORS — o proxy same-origin do Next.js, nunca o
# navegador direto (RULES_FRONTEND: sem CORS pras leituras).
# API_CORS_ORIGINS=["http://localhost:3000"]
